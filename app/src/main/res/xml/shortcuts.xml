<?xml version="1.0" encoding="utf-8"?>
<!-- Snarveier ved langt trykk på app-ikonet -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="compose"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_compose"
        android:shortcutShortLabel="@string/shortcut_compose"
        android:shortcutLongLabel="@string/shortcut_compose_long">
        <!-- targetPackage er applicationId (app.feditastic), targetClass er Kotlin-pakken -->
        <intent
            android:action="app.feditastic.action.COMPOSE"
            android:targetClass="app.pleromastisk.MainActivity"
            android:targetPackage="app.feditastic" />
    </shortcut>
</shortcuts>
